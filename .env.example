# Plan V — runtime (required)
# demo | test | staging | production
APP_MODE=demo

# demo | disabled | live
AI_MODE=demo

# Frontend demo button. Honored only when Vite runs in development.
VITE_ALLOW_DEMO=true

# Free text/meal AI only. No automatic paid fallback; quota failures stay unavailable.
AI_COST_MODE=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Direct OpenAI / recipe images remain blocked in free mode, even with this key.
OPENAI_API_KEY=

# Fotos de platos aprobados: exclusivamente FLUX.1 Schnell en Workers Free.
# Mantener la cuenta en Free; habilitar también en el worker. Nunca usar VITE_.
IMAGE_PROVIDER=
CLOUDFLARE_FREE_TIER=1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Fotos de ingredientes (opcional). Cuota diaria (día UTC) repartida entre platos e ingredientes:
# IMAGE_DAILY_LIMIT = total de intentos (por omisión 100); INGREDIENT_COVERS_DAILY_LIMIT = tope de ingredientes
# (por omisión 30, nunca más de la mitad del total; 0 las pausa).
# IMAGE_DAILY_LIMIT=100
# INGREDIENT_COVERS_DAILY_LIMIT=30

# Correos de acceso: Supabase Auth con SMTP Gmail inicial o Brevo verificado.
# Configurador scripts/auth-smtp-config.mjs: comprobar por defecto; --apply exige autorización de producción y permiso de administración. Nunca usar VITE_ para claves.
BREVO_API_KEY=
# Remitente verificado en Brevo (Senders) y nombre que ve la paciente.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Plan V

# Public API origin for the Vite client. Empty = same-origin /api (local proxy).
VITE_API_URL=

# Required when APP_MODE is staging or production
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ops-only professional provisioning (PV-09). Never send this to the browser.
PROVISION_SECRET=

# Comma-separated browser origins. Required in staging/production.
CORS_ORIGINS=

# Optional HTTPS webhook for operational alerts (no clinical payload).
ALERT_WEBHOOK_URL=

# Rate limits (staging/production on by default). Auth recover is tighter.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_OPS_MAX=10
# RATE_LIMIT_API_MAX=120

# Run the job worker as a separate process: WORKER_SEPARATE=1 npm run start:api
# plus `npm run start:worker`. Release SHA: GIT_SHA, RAILWAY_GIT_COMMIT_SHA, or VERCEL_GIT_COMMIT_SHA.

PORT=3001

# Empty disposable Postgres only. Never point this at a project with patients.
# DISPOSABLE_SUPABASE_APPLY=I_UNDERSTAND_DISPOSABLE_ONLY
# DISPOSABLE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres


# Configuración privada del operador: guardar fuera del repositorio, nunca en la web.
SMTP_PROVIDER=gmail
SMTP_USER=
SMTP_PASSWORD=
# SUPABASE_ACCESS_TOKEN sólo para el configurador del operador; no es una variable pública.

# IA de consultas: deshabilitada hasta verificar retención cero y nivel gratuito.
GROQ_API_KEY=
GROQ_ZDR_VERIFIED=0
GROQ_FREE_TIER_VERIFIED=0
CLINICAL_AI_COST_MODE=free
# El ledger impone USD 5 mensuales para todo el servicio; nunca por paciente.
