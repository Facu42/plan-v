# Plan V — runtime (required)
# demo | test | staging | production
APP_MODE=demo

# demo | disabled | live
AI_MODE=demo

# Frontend demo button. Honored only when Vite runs in development.
VITE_ALLOW_DEMO=true

# Free text/meal AI only. No automatic paid fallback; quota failures stay unavailable.
AI_COST_MODE=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Direct OpenAI / recipe images remain blocked in free mode, even with this key.
OPENAI_API_KEY=

# Fotos de platos aprobados: exclusivamente FLUX.1 Schnell en Workers Free.
# Mantener la cuenta en Free; habilitar también en el worker. Nunca usar VITE_.
IMAGE_PROVIDER=
CLOUDFLARE_FREE_TIER=1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Fotos de ingredientes (opcional). Cuota diaria (día UTC) repartida entre platos e ingredientes:
# IMAGE_DAILY_LIMIT = total de intentos (por omisión 100); INGREDIENT_COVERS_DAILY_LIMIT = tope de ingredientes
# (por omisión 30, nunca más de la mitad del total; 0 las pausa).
# IMAGE_DAILY_LIMIT=100
# INGREDIENT_COVERS_DAILY_LIMIT=30

# Correos de acceso: Supabase Auth con SMTP Gmail (elección inicial) o Brevo.
# Configurador: scripts/auth-smtp-config.mjs; credenciales fuera del repositorio.
# Gmail necesita contraseña de aplicación; SMTP de Auth no se configura en Railway.
# Operador fuera del repo: BREVO_SMTP_LOGIN, BREVO_SMTP_KEY, BREVO_SENDER_VERIFIED=1,
# SUPABASE_ACCESS_TOKEN. scripts/auth-smtp-config.mjs comprueba por defecto; --apply configura.
# Brevo API en Railway sólo para recordatorios de turnos. Nunca usar VITE_.
BREVO_API_KEY=
# Remitente verificado en Brevo (Senders) y nombre que ve la paciente.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Plan V

# IA nueva de consultas/importación. No cambia la política gratuita de OpenRouter.
GROQ_API_KEY=""
GROQ_ZDR_VERIFIED=0
GROQ_FREE_TIER_VERIFIED=0
CLINICAL_AI_COST_MODE=free
# Usar free únicamente con una cuenta Groq gratuita verificada; paid respeta USD 5 globales.

# Public API origin for the Vite client. Empty = same-origin /api (local proxy).
VITE_API_URL=

# Required when APP_MODE is staging or production
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ops-only professional provisioning (PV-09). Never send this to the browser.
PROVISION_SECRET=

# Comma-separated browser origins. Required in staging/production.
CORS_ORIGINS=

# Optional HTTPS webhook for operational alerts (no clinical payload).
ALERT_WEBHOOK_URL=

# Monitoreo de errores y eventos (Sentry). Vacío = apagado: no se manda nada
# hasta que Facundo cargue las claves. El DSN del navegador es público por diseño.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Rate limits (staging/production on by default). Auth recover is tighter.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_OPS_MAX=10
# RATE_LIMIT_API_MAX=120

# Run the job worker as a separate process: WORKER_SEPARATE=1 npm run start:api
# plus `npm run start:worker`. Release SHA: GIT_SHA, RAILWAY_GIT_COMMIT_SHA, or VERCEL_GIT_COMMIT_SHA.

PORT=3001

# Optional server-only USDA FoodData Central key. No automatic activation or paid fallback.
FDC_API_KEY=

# Empty disposable Postgres only. Never point this at a project with patients.
# DISPOSABLE_SUPABASE_APPLY=I_UNDERSTAND_DISPOSABLE_ONLY
# DISPOSABLE_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# WhatsApp oficial: activación independiente con costos propios; nunca activar en demo.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v22.0

# Agenda: claves privadas, sólo API y worker. El origen debe ser la WEB (cookie OAuth).
# SCHEDULING_BOOKING_SECRET: mínimo 32 caracteres aleatorios en staging/production para publicar la página de reservas y firmar tokens de reserva pública (en demo local usa un secreto de desarrollo).
SCHEDULING_PUBLIC_BASE_URL=https://plan-v-eight.vercel.app
SCHEDULING_TOKEN_KEY=
SCHEDULING_BOOKING_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MP_SCHEDULING_CLIENT_ID=
MP_SCHEDULING_CLIENT_SECRET=
MP_SCHEDULING_WEBHOOK_SECRET=

# Cobro de Nutridash a la nutricionista. Van en Railway, sin valor en el repo.
# PLATFORM_BILLING_ENABLED queda apagada hasta que Facundo la prenda.
MP_PLATFORM_ACCESS_TOKEN=
MP_PLATFORM_WEBHOOK_SECRET=
PLATFORM_BILLING_ENABLED=

# Correo operativo: desactivado hasta configuración y autorización explícitas.
# Supabase SMTP (alta/recuperación) es independiente de este transporte de recordatorios/difusiones.
MAIL_ENABLED=false
MAIL_PROVIDER=gmail
SMTP_PROVIDER=gmail
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Plan V
# Para elegir Brevo: MAIL_PROVIDER=brevo y usar las variables BREVO_* del bloque anterior.
