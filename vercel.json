{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/public/communications/email-unsubscribe",
      "destination": "https://api-production-aad6.up.railway.app/api/public/communications/email-unsubscribe"
    },
    {
      "source": "/api/scheduling/:path*",
      "destination": "https://api-production-aad6.up.railway.app/api/scheduling/:path*"
    },
    {
      "source": "/api/public/scheduling/:path*",
      "destination": "https://api-production-aad6.up.railway.app/api/public/scheduling/:path*"
    },
    {
      "source": "/api/billing/:path*",
      "destination": "https://api-production-aad6.up.railway.app/api/billing/:path*"
    },
    {
      "source": "/api/public/billing/:path*",
      "destination": "https://api-production-aad6.up.railway.app/api/public/billing/:path*"
    },
    {
      "source": "/consultorio/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/equipo",
      "destination": "/index.html"
    },
    {
      "source": "/pacientes",
      "destination": "/pacientes/index.html"
    },
    {
      "source": "/nutricionistas",
      "destination": "/nutricionistas/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/crm",
      "destination": "/index.html"
    },
    {
      "source": "/crm/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-raXRfKMmoh1oYPN38gTwS6zYe2kX4PapC6B76mS0/Rs=' 'sha256-evv1+XwfDqRaVqLUFaCsYDW6h5DUAKghKr4XNxBhzFE='; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://wvosvlxpfytokwfbcero.supabase.co wss://wvosvlxpfytokwfbcero.supabase.co https://api-production-aad6.up.railway.app; worker-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.mercadopago.com https://www.mercadopago.com.ar https://auth.mercadopago.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
