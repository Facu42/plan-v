{
  "name": "plan-v-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "concurrently": {
      "shell-quote": "1.12.0"
    }
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "panel:contrato": "node scripts/panel-nutri-boceto-contrato.mjs",
    "panel:v29": "node scripts/panel-v29-css.mjs",
    "panel:v29:check": "node scripts/panel-v29-css.mjs --check",
    "panel:contrato:v29": "node scripts/panel-v29-contrato.mjs",
    "demo:consultorio": "node scripts/demo-consultorio.mjs",
    "dashboard": "node implementation-dashboard/server.mjs",
    "dashboard:test": "node --test implementation-dashboard/verification.mjs",
    "dev": "concurrently -n api,vite -c blue,green \"npm run dev:api\" \"npm run dev:vite\"",
    "dev:api": "node scripts/with-env.mjs tsx watch server/index.ts",
    "dev:vite": "node scripts/prepare-clinical-pdf.mjs && node scripts/with-env.mjs vite --host",
    "build": "node scripts/prepare-patient-import-ocr.mjs && node scripts/prepare-clinical-pdf.mjs && npm run nutrigo:styles && vite build",
    "nutrigo:styles": "node scripts/build-nutrigo-styles.mjs",
    "nutrigo:source": "node scripts/build-nutrigo-source.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:auth-isolation": "node scripts/test-auth-isolation.mjs",
    "check:migrations": "node scripts/check-migration-safety.mjs",
    "check:release-manifest": "node scripts/check-release-manifest.mjs",
    "check:views": "tsx server/security/check-public-view-grants.ts",
    "apply:disposable": "node scripts/apply-disposable.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "figma:pull": "node scripts/figma-pull.mjs",
    "disposable:pg": "node scripts/disposable-pg.mjs",
    "test:disposable": "vitest run server/cut1.disposable.test.ts server/rls-ab.test.ts",
    "test:live-auth": "PLANV_LIVE_AUTH=1 vitest run server/live-auth-storage.test.ts server/rls-ab.test.ts",
    "backup": "node scripts/with-env.mjs tsx server/ops/backup.ts",
    "restore": "node scripts/with-env.mjs tsx server/ops/restore.ts",
    "worker": "node scripts/with-env.mjs tsx server/jobs/worker-main.ts",
    "start:api": "node scripts/with-env.mjs tsx server/index.ts",
    "start:worker": "node scripts/with-env.mjs tsx server/jobs/worker-main.ts",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.53",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/poppins": "5.3.0",
    "@hono/node-server": "^2.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.4",
    "@tesseract.js-data/spa": "^1.0.0",
    "ai": "^7.0.87",
    "hono": "4.13.12",
    "jszip": "^3.10.2",
    "nodemailer": "10.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "pg": "^8.23.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.0",
    "wawoff2": "^2.0.1"
  }
}
